* { box-sizing: border-box; user-select: none; -webkit-tap-highlight-color: transparent; }
html, body {
    margin: 0; padding: 0; width: 100%; height: 100dvh;
    overflow: hidden; background: #090b09;
    font-family: 'Courier New', Courier, monospace; color: #f4f6f2;
    display: flex; justify-content: center; align-items: center;
}
#game-frame {
    position: relative;
    width: min(100vw, calc(100dvh * 9 / 16));
    height: min(100dvh, calc(100vw * 16 / 9));
    background: #141a13; overflow: hidden;
    box-shadow: 0 0 36px rgba(0,0,0,0.9);
}
#gameCanvas {
    width: 100%; height: 100%; display: block;
    image-rendering: pixelated; image-rendering: crisp-edges;
    touch-action: none;
}
#ui-tooltip {
    position: fixed; z-index: 60; pointer-events: none;
    background: rgba(12,16,12,0.95); border: 1px solid #f4d03f;
    color: #ffeb3b; padding: 4px 8px; border-radius: 5px;
    font-size: 11px; display: none; white-space: nowrap;
}
#hud-mini {
    position: absolute; top: 8px; left: 8px; z-index: 15;
    background: rgba(10,14,10,0.75); border: 1px solid rgba(255,255,255,0.14);
    border-radius: 6px; padding: 5px 8px; font-size: 10px; line-height: 1.4;
    pointer-events: none;
}
#icon-bar-top {
    position: absolute; top: 8px; right: 8px; z-index: 20;
    display: flex; gap: 6px;
}
.icon-btn {
    width: 34px; height: 34px; border-radius: 8px;
    background: rgba(18,24,18,0.88); border: 1px solid rgba(244,208,63,0.6);
    color: #f4d03f; font-size: 15px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
}
.icon-btn.active { background: #2e7d32; border-color: #a5d6a7; color: #fff; }
.icon-btn.muted { opacity: 0.6; color: #bbb; border-color: rgba(255,255,255,0.2); }
#chat-dock {
    position: absolute; bottom: 8px; left: 8px; right: 8px; z-index: 20;
    display: none; gap: 6px; align-items: center;
    background: rgba(12,16,12,0.85); border: 1px solid rgba(255,255,255,0.18);
    padding: 5px; border-radius: 8px;
}
#chat-input {
    flex: 1; min-width: 0; background: #0c100c; border: 1px solid #485644;
    color: #fff; padding: 6px 8px; border-radius: 6px;
    font-family: inherit; font-size: 12px; outline: none;
}
#login-screen {
    position: absolute; inset: 0; background: rgba(10,14,10,0.96);
    display: flex; justify-content: center; align-items: center; z-index: 30; padding: 10px;
}
#login-box {
    width: 100%; background: #1a2118; border: 2px solid #5a6b52;
    border-radius: 10px; padding: 14px;
}
.title-txt { margin: 0 0 10px; text-align: center; color: #f4d03f; font-size: 15px; }
.creator-row { display: flex; gap: 10px; align-items: center; margin-bottom: 8px; }
.preview-box {
    width: 84px; height: 96px; background: #e8e6df;
    border: 2px solid #75876b; border-radius: 8px;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
#previewCanvas { image-rendering: pixelated; image-rendering: crisp-edges; }
.opt-label { font-size: 10px; color: #b8c4b2; margin-bottom: 3px; display: block; }
.btn-row { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 7px; }
.mini-btn {
    background: #283326; border: 1px solid #4e5e48; color: #e0e6dc;
    padding: 4px 7px; border-radius: 4px; font-family: inherit; font-size: 10px; cursor: pointer;
}
.mini-btn.active { background: #d4af37; color: #111; font-weight: bold; }
.swatch { width: 18px; height: 18px; border-radius: 4px; border: 2px solid #3c4639; cursor: pointer; }
.swatch.active { border-color: #fff; }
input[type="text"] {
    width: 100%; background: #10140f; border: 1px solid #4e5e48;
    color: #fff; padding: 7px 9px; border-radius: 6px; font-family: inherit; font-size: 12px; outline: none;
}
.go-btn {
    width: 100%; background: #467832; border: 2px solid #79b85c; color: #fff;
    padding: 10px; border-radius: 7px; font-family: inherit; font-size: 13px;
    font-weight: bold; cursor: pointer; margin-top: 10px;
}
